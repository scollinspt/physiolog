@article{collins_acute_nodate,
	title = {Acute {Care} {Physical} {Therapy} in {Patients} with {Pacemakers}},
	copyright = {All rights reserved},
	abstract = {Cardiac pacemakers play an important role in the treatment of cardiac rhythm disturbances. Improved technologies have increased pacemaker application in the treatment of heart disease beyond rhythm disorders including coronary artery disease and heart failure. In addition, a larger proportion of individuals survive initial cardiovascular disease diagnosis which may require cardiac pacing. As the use of pacemakers increase physical therapists are more likely to encounter patients with a pacemaker, and as the technology of pacemakers expands so does the potential role and impact of pacemakers for physical therapy intervention, therefore, understanding pacemakers becomes more important for sound clinical decisions. The potential role of physical therapy in the care of persons with pacemakers includes assisting with the (1) setting of pacing parameters (with electrophysiological physicians) to obtain optimal functional and exercise outcomes; (2) establishment of safe functional and exercise activities for patients with pacemakers and automatic implanted cardio defibrillators (AICDs); and (3) assuring proper pacemaker functioning during functional activities and exercise. This paper presents indications and types of pacemakers (including coding and modes) and suggestions so that the physical therapist can provide optimal care to patients with cardiac pacemakers.},
	language = {en},
	author = {Collins, Sean M and Cahalin, CCS Lawrence P},
}

@article{karasek_alternative_2004,
	title = {An {Alternative} {Economic} {Vision} for {Healthy} {Work}: {Conducive} {Economy}},
	volume = {24},
	copyright = {https://journals.sagepub.com/page/policies/text-and-data-mining-license},
	issn = {0270-4676, 1552-4183},
	shorttitle = {An {Alternative} {Economic} {Vision} for {Healthy} {Work}},
	url = {https://journals.sagepub.com/doi/10.1177/0270467604269502},
	doi = {10.1177/0270467604269502},
	abstract = {A model of production and exchange is proposed as an alternative to both market-oriented policy and social welfare policy. New patterns of social coordination at work form the basis for a new form of production output value: conducive value. This value is developed in both workers and consumers, activates skills and capabilities, and transforms customers from passive recipients to active users. It broadens the definition of economically valid social activity and it will help to resolve the unemployment dilemma arising with globalization. The article observes that the flexibility demanded by neoliberal, market-oriented policy is antithetical to the flexibility of creative production, which builds on horizontal interaction at work and in exchange, thereby facilitating the creation of social relationships and social capital. In that, it constructs bridges between the new policy and models of social policy which form its platform and enhances the chances for effective democracy in society.},
	language = {en},
	number = {5},
	urldate = {2026-03-10},
	journal = {Bulletin of Science, Technology \& Society},
	author = {Karasek, Robert A.},
	month = oct,
	year = {2004},
	pages = {397--429},
}

