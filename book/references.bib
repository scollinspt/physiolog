@article{benjamin_management_2022,
	title = {Management of patient tubes and lines during early mobility in the intensive care unit},
	volume = {2},
	issn = {27725014},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2772501422000148},
	doi = {10.1016/j.hfh.2022.100017},
	abstract = {Objective: The purpose of this study was to better understand the impact of patient tubes/lines on early mobility therapy sessions for patients in the intensive care unit (ICU).
Background: Early mobility improves patient outcomes in the ICU, but its use is suboptimal. Signiﬁcant barriers to early mobility include the risk of dislodging patient tubes/lines, nursing workload, and staﬃng constraints.
Method: Secondary statistical analyses were conducted on an existing quality improvement dataset collected during the observation of 22 early mobility therapy sessions in four ICUs at two hospitals using descriptive statistics, Pearson’s correlation coeﬃcient, and Spearman rho’s calculations.
Results: Patients had an average of 8.6 tubes/lines. During each early mobility session, staﬀ spent an average of 12.4 minutes, or 61.4\% of the total duration of time, focused on the management of patient tubes/lines. Signiﬁcant positive correlations were found between; 1) the number of patient tubes/lines and the amount of time needed by staﬀ to organize and manage them during early mobility activities (r = 0.517, p = 0.014), and 2) the number of patient tubes/lines and the number of staﬀ required to assist during early mobility activities (r = 0.630, p = 0.002).
Conclusion: Patient tube/line management has signiﬁcant implications on ICU staﬀ time and workload during early mobility. Additional research is needed to better understand how nurses and other frontline staﬀ manage patient tubes/lines during mobilization in the ICU.},
	language = {en},
	urldate = {2023-01-20},
	journal = {Human Factors in Healthcare},
	author = {Benjamin, Ellen and Roddy, Lindsey and Giuliano, Karen K.},
	month = dec,
	year = {2022},
	pages = {100017},
}

